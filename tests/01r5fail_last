# create a RAID10 from partitions, try to fail both legs.
# mdadm should refuse to fail the second one.

if [[ $DEVTYPE = disk ]]; then
    SEP=
else
    SEP=p
fi

mdadm -CR $md0 -l5 -n3 --assume-clean $dev4 $dev5 $dev6
mdadm $md0 --fail $dev4
check state _UU
mdadm $md0 --fail $dev5
[[ $? = 1 ]] || die "mdadm should return 1"
check state _UU

read _st < /sys/block/md0/md/array_state
[[ "$_st" = clean ]] || die "array state of $md0 is \"$_st\", should be \"clean\""
mdadm -S "$md0"

for d in $dev0 $dev1 $dev2; do
    sfdisk $d <<EOF
label:gpt
2048,,L
EOF
    partx -a $d
done
udevadm settle

mdadm -CR $md0 -l5 -n3 --assume-clean ${dev0}${SEP}1 ${dev1}${SEP}1 ${dev2}${SEP}1
mdadm $md0 --fail ${dev0}${SEP}1
check state _UU
mdadm $md0 --fail ${dev2}${SEP}1
[[ $? = 1 ]] || die "mdadm should return 1"
check state _UU

read _st < /sys/block/md0/md/array_state
[[ "$_st" = clean ]] || die "array state of $md0 is \"$_st\", should be \"clean\""

mdadm -S $md0
