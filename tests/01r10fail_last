# create a RAID10 from partitions, try to fail both legs.
# mdadm should refuse to fail the second one.

if [[ $DEVTYPE = disk ]]; then
    SEP=
else
    SEP=p
fi

mdadm -CR $md0 -l10 --layout=n2 -n4 --assume-clean $dev4 $dev5 $dev6 $dev8
mdadm $md0 --fail $dev4
check state _UUU
mdadm $md0 --fail $dev8
check state _UU_
mdadm $md0 --fail $dev5
[[ $? = 1 ]] || die "mdadm should return 1"
check state _UU_

read _st < /sys/block/md0/md/array_state
[[ "$_st" = clean ]] || die "array state of $md0 is \"$_st\", should be \"clean\""
mdadm -S "$md0"

for d in $dev0 $dev1 $dev2 $dev3; do
    sfdisk $d <<EOF
label:gpt
2048,,L
EOF
    partx -a $d
done
udevadm settle

mdadm -CR $md0 -l10 --layout=n2 -n4 --assume-clean ${dev0}${SEP}1 ${dev1}${SEP}1 ${dev2}${SEP}1 ${dev3}${SEP}1
mdadm $md0 --fail ${dev0}${SEP}1
check state _UUU
mdadm $md0 --fail ${dev3}${SEP}1
check state _UU_
mdadm $md0 --fail ${dev2}${SEP}1
[[ $? = 1 ]] || die "mdadm should return 1"
check state _UU_

read _st < /sys/block/md0/md/array_state
[[ "$_st" = clean ]] || die "array state of $md0 is \"$_st\", should be \"clean\""

mdadm -S $md0

mdadm -CR $md0 -l10 --layout=n2 -n4 --assume-clean ${dev0}${SEP}1 ${dev1}${SEP}1 ${dev2}${SEP}1 ${dev3}${SEP}1
mdadm $md0 --fail set-A
check state _U_U
mdadm $md0 --fail set-B
[[ $? = 1 ]] || die "mdadm should return 1"
check state _U_U
read _st < /sys/block/md0/md/array_state
[[ "$_st" = clean ]] || die "array state of $md0 is \"$_st\", should be \"clean\""
